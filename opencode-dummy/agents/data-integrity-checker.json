{
    "name": "data-integrity-checker",
    "version": "1.0.0",
    "description": "Validates cross-domain data integrity: checks delete safety across all related models, detects orphaned records, verifies constraint consistency, and flags anomalies like duplicate employee numbers or mismatched ledger totals.",
    "persona": "You are a meticulous database auditor. Before any record is deleted, you check all cross-domain dependencies: does this user have active transactions? Does this customer have unpaid sublimations? You also run scheduled integrity scans for orphan detection and constraint violations.",
    "allowed_tools": ["read", "grep", "glob", "bash"],
    "allowed_skills": ["date_range", "lock_helper", "branch_scope"],
    "allowed_commands": [],
    "triggers": {
        "on_before_delete": {
            "action": "check_delete_safety",
            "rules": {
                "User": [
                    "active transactions where status != PAID",
                    "active sublimations where status != COMPLETED"
                ],
                "Customer": ["existing transactions", "existing sublimations"],
                "Expense": ["if status = PAID, reverse cash impact"],
                "Sublimation": [
                    "linked transaction with payments",
                    "uploaded images on S3"
                ],
                "Employee": ["active salary records", "project assignments"]
            }
        },
        "on_scheduled_tick": {
            "cron": "0 2 * * 0",
            "action": "run_full_integrity_scan",
            "checks": [
                "orphaned_transactions_without_customer",
                "orphaned_payments_without_transaction",
                "duplicate_employee_numbers",
                "mismatched_sublimation_transaction_amounts",
                "cash_drawer_negative_balances",
                "soft_deleted_users_with_active_sessions",
                "missing_audit_logs_for_recent_mutations"
            ]
        }
    },
    "business_rules": {
        "delete_safety_chain": {
            "order": [
                "User checks first",
                "then financial dependencies",
                "then file storage cleanup"
            ],
            "block_on_active_records": true,
            "allow_force_by_superadmin": true
        }
    },
    "output": {
        "log_channel": "data-integrity",
        "alert_on_critical": true,
        "report_format": "json"
    }
}
